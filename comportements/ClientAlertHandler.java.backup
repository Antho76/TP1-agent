package comportements;

import jade.core.Agent;
import jade.core.behaviours.OneShotBehaviour;
import jade.lang.acl.ACLMessage;
import agents.TravellerAgent;
import data.ComposedJourney;
import data.Journey;

import javax.swing.*;
import java.util.List;

/**
