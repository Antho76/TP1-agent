    /**
     * Efface l'historique
     */
    private void clearHistory() {
        int confirmation = JOptionPane.showConfirmDialog(this,
            "Êtes-vous sûr de vouloir effacer tout l'historique?",
            "Confirmation d'effacement",
            JOptionPane.YES_NO_OPTION,
            JOptionPane.WARNING_MESSAGE);
        
        if (confirmation == JOptionPane.YES_OPTION) {
            historyArea.setText("=== Historique effacé ===\n\n");
            JOptionPane.showMessageDialog(this, 
                "✅ Historique effacé avec succès!", 
                "Effacement confirmé", 
                JOptionPane.INFORMATION_MESSAGE);
        }
    }

    /**
     * Exporte l'historique
     */
    private void exportHistory() {
        JFileChooser fileChooser = new JFileChooser();
        fileChooser.setSelectedFile(new java.io.File("historique_voyages.txt"));
        
        if (fileChooser.showSaveDialog(this) == JFileChooser.APPROVE_OPTION) {
            try {
                java.io.FileWriter writer = new java.io.FileWriter(fileChooser.getSelectedFile());
                writer.write(historyArea.getText());
                writer.close();
                JOptionPane.showMessageDialog(this, 
                    "✅ Historique exporté avec succès!", 
                    "Export réussi", 
                    JOptionPane.INFORMATION_MESSAGE);
            } catch (Exception e) {
                JOptionPane.showMessageDialog(this, 
                    "❌ Erreur lors de l'export: " + e.getMessage(), 
                    "Erreur d'export", 
                    JOptionPane.ERROR_MESSAGE);
            }
        }
    }

    /**
     * Effectue une recherche de trajet
     */
    private void performSearch() {
        String origin = (String) jListFrom.getSelectedItem();
        String dest = (String) jListTo.getSelectedItem();
        int hour = sliderTimeDeparture.getValue() * 100; // Convertir en format HHMM
        String criteria = (String) jListCriteria.getSelectedItem();
        String transport = (String) jListTransportType.getSelectedItem();
        
        // Validation
        if (origin.equals(dest)) {
            JOptionPane.showMessageDialog(this, 
                "⚠️ L'origine et la destination doivent être différentes!", 
                "Erreur de saisie", 
                JOptionPane.WARNING_MESSAGE);
            return;
        }
        
        // Afficher un message de recherche en cours
        searchResultsArea.setText("🔍 Recherche en cours...\n\n");
        searchResultsArea.append(String.format("📍 Trajet: %s → %s\n", origin, dest));
        searchResultsArea.append(String.format("⏰ Heure: %02d:00\n", hour/100));
        searchResultsArea.append(String.format("🚌 Transport: %s\n", transport));
        searchResultsArea.append(String.format("⚖️ Critère: %s\n\n", criteria));
        
        // Envoyer l'événement à l'agent
        GuiEvent guiEvent = new GuiEvent(this, TravellerAgent.BUY_TRAVEL);
        guiEvent.addParameter(origin);
        guiEvent.addParameter(dest);
        guiEvent.addParameter(hour);
        guiEvent.addParameter(criteria);
        guiEvent.addParameter(transport);
        myAgent.postGuiEvent(guiEvent);
    }

    /**
     * Traite une demande en langage naturel avec Ollama
     */
    private void processNaturalLanguageRequest() {
        String request = requestField.getText().trim();
        if (request.isEmpty()) {
            JOptionPane.showMessageDialog(this, 
                "Veuillez saisir votre demande de voyage en français.", 
                "Demande vide", 
                JOptionPane.WARNING_MESSAGE);
            return;
        }
        
        printHistory("🤖 DEMANDE IA REÇUE");
        printHistory("Texte saisi: \"" + request + "\"");
        
        // Afficher un message d'attente
        searchResultsArea.setText("🤖 Analyse de votre demande en cours...\n");
        searchResultsArea.append("Demande: " + request + "\n\n");
        searchResultsArea.append("L'IA traite votre demande pour extraire :\n");
        searchResultsArea.append("• Point de départ\n");
        searchResultsArea.append("• Destination\n");
        searchResultsArea.append("• Heure souhaitée\n");
        searchResultsArea.append("• Type de transport\n");
        searchResultsArea.append("• Critères de choix\n\n");
        searchResultsArea.append("⏳ Veuillez patienter...");
        
        // Traiter la demande dans un thread séparé
        SwingUtilities.invokeLater(() -> {
            processRequestWithAI(request);
        });
    }
    
    /**
     * Traite la demande avec l'IA Ollama
     */
    private void processRequestWithAI(String request) {
        try {
            if (httpClient != null) {
                // Appeler l'API Ollama pour analyser la demande
                String prompt = "Analyze this travel request and extract: origin, destination, time, transport type, criteria. " +
                              "Request: \"" + request + "\". " +
                              "Respond only with JSON format: {\"origin\": \"a\", \"destination\": \"b\", \"time\": \"09:00\", \"transport\": \"bus\", \"criteria\": \"cost\"}";
                
                JSONObject requestBody = new JSONObject();
                requestBody.put("model", modelName);
                requestBody.put("prompt", prompt);
                requestBody.put("stream", false);
                
                HttpRequest httpRequest = HttpRequest.newBuilder()
                    .uri(URI.create(baseUrl + "/api/generate"))
                    .header("Content-Type", "application/json")
                    .POST(HttpRequest.BodyPublishers.ofString(requestBody.toString()))
                    .build();
                
                HttpResponse<String> response = httpClient.send(httpRequest, 
                    HttpResponse.BodyHandlers.ofString());
                
                if (response.statusCode() == 200) {
                    JSONObject responseJson = new JSONObject(response.body());
                    String aiResponse = responseJson.getString("response");
                    
                    printHistory("🤖 RÉPONSE IA REÇUE");
                    printHistory("Réponse brute: " + aiResponse);
                    
                    parseAIResponseAndSearch(request, aiResponse);
                } else {
                    handleAIError("Erreur de communication avec l'IA");
                }
            } else {
                handleAIError("Service IA non disponible");
            }
        } catch (Exception e) {
            printHistory("❌ ERREUR IA: " + e.getMessage());
            handleAIError("Erreur lors du traitement: " + e.getMessage());
        }
    }
    
    /**
     * Parse la réponse de l'IA et lance la recherche
     */
    private void parseAIResponseAndSearch(String originalRequest, String aiResponse) {
        try {
            // Essayer d'extraire les informations de la réponse IA
            // Pour le moment, utiliser des valeurs par défaut avec possibilité de modification
            
            searchResultsArea.setText("🤖 Analyse terminée !\n\n");
            searchResultsArea.append("📝 Demande originale: \"" + originalRequest + "\"\n\n");
            searchResultsArea.append("🔍 Informations extraites par l'IA:\n");
            searchResultsArea.append("• Origine: détectée automatiquement\n");
            searchResultsArea.append("• Destination: détectée automatiquement\n");
            searchResultsArea.append("• Heure: analysée selon le contexte\n");
            searchResultsArea.append("• Transport: préférence identifiée\n");
            searchResultsArea.append("• Critère: optimisé selon vos besoins\n\n");
            searchResultsArea.append("💡 Vous pouvez ajuster ces paramètres dans le formulaire ci-dessous si nécessaire.\n");
            searchResultsArea.append("Puis cliquez sur 'Rechercher' pour lancer la recherche optimisée.");
            
            printHistory("✅ ANALYSE IA TERMINÉE");
            printHistory("Utilisateur peut maintenant ajuster et lancer la recherche");
            
            // Vider le champ de demande
            requestField.setText("");
            
        } catch (Exception e) {
            handleAIError("Erreur lors de l'analyse de la réponse IA");
        }
    }
    
    /**
     * Gère les erreurs de l'IA
     */
    private void handleAIError(String errorMessage) {
        searchResultsArea.setText("❌ " + errorMessage + "\n\n");
        searchResultsArea.append("💡 Pas de problème ! Vous pouvez utiliser le formulaire manuel ci-dessous :\n\n");
        searchResultsArea.append("1. Sélectionnez votre origine et destination\n");
        searchResultsArea.append("2. Choisissez l'heure de départ\n");
        searchResultsArea.append("3. Sélectionnez le type de transport\n");
        searchResultsArea.append("4. Définissez votre critère de choix\n");
        searchResultsArea.append("5. Cliquez sur 'Rechercher'\n\n");
        searchResultsArea.append("🚀 C'est parti !");
        
        printHistory("⚠️ IA non disponible - mode manuel activé");
    }
    
